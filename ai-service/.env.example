DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# LLM: default = local Ollama (no key, private). Install ollama.com, then: ollama pull qwen2.5:7b
# Alternatives: google (free AI Studio key), anthropic, groq. Unreachable model/empty key = mock mode.
LLM_PROVIDER=ollama      # ollama | google | anthropic | groq
OLLAMA_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=               # empty = default for the provider (gemini-2.5-flash / claude-opus-5-5 / llama-3.3-70b-versatile)
NODE_INTERNAL_URL=http://localhost:4000
INTERNAL_KEY=change-me-shared-with-ai-service
# Optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trojanscout-ingest/0.1
LANGSMITH_API_KEY=
# Listings pipeline
REFRESH_MINUTES=60
RENTCAST_API_KEY=       # optional: licensed real-time listings (free tier 50 calls/mo)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
